@model IEnumerable<Rental_Car_Project.ViewModels.VehicleListItemViewModel>

@{
    ViewData["Title"] = "Veículos";
}

<h1>Veículos</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Novo veículo</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted">Ainda não existem veículos registados.</p>
}
else
{
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>Marca</th>
                <th>Modelo</th>
                <th>Matrícula</th>
                <th>Ano</th>
                <th>Combustível</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Vehicle.Brand</td>
                    <td>@item.Vehicle.Model</td>
                    <td>@item.Vehicle.LicensePlate</td>
                    <td>@item.Vehicle.ManufactureYear</td>
                    <td>@Html.DisplayFor(_ => item.Vehicle.FuelType)</td>
                    <td>
                        @if (item.IsRented)
                        {
                            <span class="badge bg-danger">Alugado</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Disponível</span>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Vehicle.Id">Editar</a> |
                        <a asp-action="Details" asp-route-id="@item.Vehicle.Id">Detalhes</a> |
                        <a asp-action="Delete" asp-route-id="@item.Vehicle.Id">Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}