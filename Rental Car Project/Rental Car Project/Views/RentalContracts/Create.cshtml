@model Rental_Car_Project.Models.RentalContract

@{
    ViewData["Title"] = "Novo Contrato";
    // Data de hoje no formato do campo de data, para bloquear dias passados no calendário
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<h1>Novo Contrato de Aluguer</h1>
<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ClientId" class="form-label"></label>
                <select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId">
                    <option value="">-- Selecione o cliente --</option>
                </select>
                <span asp-validation-for="ClientId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VehicleId" class="form-label"></label>
                <select asp-for="VehicleId" class="form-select" asp-items="ViewBag.VehicleId">
                    <option value="">-- Selecione o veículo --</option>
                </select>
                <span asp-validation-for="VehicleId" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col mb-3">
                    <label asp-for="StartDate" class="form-label"></label>
                    <input asp-for="StartDate" type="date" min="@today" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="col mb-3">
                    <label asp-for="EndDate" class="form-label"></label>
                    <input asp-for="EndDate" type="date" min="@today" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="InitialMileage" class="form-label"></label>
                <div class="input-group">
                    <input asp-for="InitialMileage" min="0" class="form-control" />
                    <span class="input-group-text">km</span>
                </div>
                <span asp-validation-for="InitialMileage" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Registar contrato</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}